{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Find My Voice",
  "version": "0.2.0",
  "identifier": "com.findmyvoice.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Find My Voice",
        "width": 480,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
