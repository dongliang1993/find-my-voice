{
  "name": "find-my-voice",
  "version": "0.2.0",
  "description": "A local chat companion that can talk, listen and remember — powered by your own Claude and voice accounts",
  "type": "module",
  "bin": {
    "find-my-voice": "bin/find-my-voice.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "voices.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dongliang1993/find-my-voice.git"
  },
  "homepage": "https://github.com/dongliang1993/find-my-voice#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts --no-open",
    "onboard:reset": "node scripts/onboard-reset.mjs",
    "onboard:wipe": "node scripts/onboard-reset.mjs --wipe",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "build:app": "npm run build && cargo-tauri build && node scripts/assemble-sidecar.mjs",
    "start": "node dist/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@msgpack/msgpack": "^3.1.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vaul": "^1.1.2",
    "vite": "^8.3.5"
  }
}
