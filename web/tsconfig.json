{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "noEmit": true,
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../src/shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../src/shared/**/*.ts"]
}
