# Loopback only. The owner page needs no login; MCP over stdio needs no token.
HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
OWNER_ID=local-owner
# Only for HTTP /mcp (remote clients). The stdio entry ignores it.
MCP_TOKEN=
MEDIA_SIGNING_KEY=

# Real provider is the default. Missing credentials produce a setup error.
TTS_PROVIDER=volcengine
# Local stdio only. adaptive is a standing user opt-in; none/explicit preserve file-only behavior.
VOICE_REPLY_MODE=explicit
LOCAL_AUDIO_PLAYBACK=none
# tts: fixed-speaker V3 streaming. seed-audio: generative, complete audio response.
VOLC_API_MODE=tts
SEED_AUDIO_TIMEOUT_MS=300000
# New console authentication:
VOLC_API_KEY=
# Old console authentication (used only if VOLC_API_KEY is empty):
VOLC_APP_ID=
VOLC_ACCESS_KEY=
# Use the resource ID enabled in your account. 2.0 example: seed-tts-2.0
VOLC_RESOURCE_ID=
# A bootstrap voice for testing, not an automatically confirmed persona voice.
VOLC_DEFAULT_VOICE=
VOLC_DEFAULT_VOICE_NAME=
TTS_TIMEOUT_MS=45000
TTS_MAX_CHARACTERS=500
TTS_MAX_CONCURRENCY=2
TTS_REQUESTS_PER_MINUTE=10
AUDIO_RETENTION_DAYS=7
MEDIA_LINK_MINUTES=30
