        "blocks": [
          {
            "id": "t1",
            "type": "paragraph",
            "text": "A few small things for tomorrow, so you don't have to hold them in your head tonight."
          },
          {
            "id": "t2",
            "type": "item",
            "name": "Tidy up the room",
            "note": "Ten minutes is enough."
          },
          {
            "id": "t3",
            "type": "item",
            "name": "Call home",
            "note": "Just to say hi."
          },
          {
            "id": "t4",
            "type": "paragraph",
            "text": "Natasha"
          }
        ]
      }
